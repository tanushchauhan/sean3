# ROS 2 Humble environment for the SEAN 3 ROS side (Ubuntu 22.04).
# The Unity simulator runs on the host and connects over the ROS-TCP-Endpoint port.
FROM osrf/ros:humble-desktop

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git python3-colcon-common-extensions python3-rosdep python3-vcstool \
        python3-pip xvfb \
        ros-humble-navigation2 ros-humble-nav2-bringup \
        ros-humble-slam-toolbox \
        ros-humble-ros2-control ros-humble-ros2-controllers \
        ros-humble-xacro ros-humble-tf2-ros ros-humble-tf2-tools \
        ros-humble-pointcloud-to-laserscan \
        ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# Unity-side TCP bridge (ROS 2 branch). Pin a commit once the working combination is verified.
ARG TCP_ENDPOINT_REF=main-ros2
RUN mkdir -p /opt/sean3_ws/src && cd /opt/sean3_ws/src \
    && git clone --depth 1 --branch ${TCP_ENDPOINT_REF} https://github.com/Unity-Technologies/ROS-TCP-Endpoint.git

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
WORKDIR /opt/sean3_ws
RUN . /opt/ros/humble/setup.sh && colcon build --symlink-install

COPY entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
